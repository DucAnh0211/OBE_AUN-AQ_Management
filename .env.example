# Docker Compose defaults for local demo and team development.
POSTGRES_DB=obe_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
# EF demo seed runs only when Curriculum has no programs; never resets existing data.
SEED_DEMO=true

WEB_PORT=8080
API_PORT=5099
POSTGRES_PORT=5432
AI_PORT=8000
# Local .NET: uncomment and point to the database you intend to use (5432 local / 5433 Docker).
# ConnectionStrings__Postgres='Host=localhost;Port=5433;Database=obe_management;Username=postgres;Password=YOUR_PASSWORD'

CORS_ORIGIN=http://localhost:8080

# Use secrets with at least 32 random characters outside local development.
JWT_SIGNING_KEY=replace_with_a_random_secret_of_at_least_32_characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu.vn
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123
BOOTSTRAP_ADMIN_FULL_NAME=Quản trị viên

# Knowledge Base: local backend connects to MinIO through the host port.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=obe-knowledge
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=change_minio_password
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
RERANK_MODEL=gpt-4.1-mini
DOTNET_API_URL=http://localhost:5099

# For the API inside Compose; local API uses OBJECT_STORAGE_ENDPOINT above.
OBJECT_STORAGE_DOCKER_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Use an existing trusted image, or build infra/minio/Dockerfile and set MINIO_IMAGE=obe-minio:local.
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
# Local Python OCR: install Tesseract + vie/eng language packs; PDF renderer is a pip dependency.
OCR_TESSERACT_PATH=tesseract
OCR_LANGUAGES=vie+eng

# Internal .NET -> Python API. Use the same random key in both processes.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace_with_a_random_internal_key_of_at_least_32_characters
